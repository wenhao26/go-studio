# 统一行尾策略：仓库内一律 LF，避免在 Windows 上产生全文件 CRLF diff。
# 详见 PROJECT_ALIGNMENT_REPORT.md §3.0.3。

* text=auto

# Go 源码、文档与配置：强制 LF
*.go      text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.md      text eol=lf
*.sql     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.toml    text eol=lf
*.proto   text eol=lf
*.sh      text eol=lf
Makefile  text eol=lf

# Windows 脚本：保持 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# 二进制文件不参与行尾转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.gz      binary
